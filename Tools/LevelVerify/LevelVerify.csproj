<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>LevelVerify</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS0067;CS0169;CS0414;CS0649;CS8618;CS8625;CS0162;CS0219;CS0472;CS0473;CS1998;CS4014;CS0168;CS0108;CS0114</NoWarn>
    <RootNamespace>LevelVerify</RootNamespace>
  </PropertyGroup>
  <!-- 关卡集离线校验 runner：编译真实 Runtime 源码 + Unity 桩，直接跑真实
       BlockOutLevelParser / BlockOutSolver / BlockOutContentConfig 逻辑。
       不启动 Unity、不触发刷新/编译/Domain Reload，只产出静态运行证据。 -->
  <ItemGroup>
    <Compile Include="..\CompileCheck\UnityEngineStub.cs" />
    <Compile Include="..\CompileCheck\UnityUiStub.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Assets\BlockOut\Runtime\**\*.cs" />
  </ItemGroup>
</Project>
